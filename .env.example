# Copy this file to .env and fill in real values.
# .env is gitignored and must never be committed.

# Which mode to run: scan | compare | direct_compare | sftp_compare
MODE=scan

# ---- scan mode ----
SCAN_SIDE_LABEL=A
SCAN_ROOT_FOLDER=C:\path\to\folder_to_scan

# ---- compare mode ----
MANIFEST_A_PATH=manifest_A.json
MANIFEST_B_PATH=manifest_B.json

# ---- direct_compare mode ----
FOLDER_A=C:\path\to\folder_a
FOLDER_B=D:\mapped_rdp_drive\folder_b

# ---- sftp_compare mode ----
# Folder A lives on the SFTP server; folder B is local to this machine.
SFTP_HOST=sftp.example.com
SFTP_PORT=22
SFTP_USERNAME=your_username
SFTP_PASSWORD=your_password
# Leave SFTP_PASSWORD blank and set this instead to use key-based auth:
SFTP_PRIVATE_KEY_PATH=
SFTP_ROOT_FOLDER=/remote/path/to/folder_a
LOCAL_ROOT_FOLDER=C:\path\to\folder_b

# ---- shared by compare / direct_compare / sftp_compare ----
LABEL_A=Folder A
LABEL_B=Folder B
EXCEL_REPORT_PATH=folder_sync_report.xlsx

# ---- comparison behavior ----
TIMESTAMP_TOLERANCE_SECONDS=2
CASE_INSENSITIVE_MATCH=true
INCLUDE_IDENTICAL_SHEET=false
