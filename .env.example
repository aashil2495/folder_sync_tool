# Copy this file to .env and fill in real values.
# .env is gitignored and must never be committed.

# Folder A lives on the SFTP server; folder B is local to this machine.
SFTP_HOST=sftp.example.com
SFTP_PORT=22
SFTP_USERNAME=your_username
SFTP_PASSWORD=your_password
# Leave SFTP_PASSWORD blank and set this instead to use key-based auth:
SFTP_PRIVATE_KEY_PATH=
SFTP_ROOT_FOLDER=/remote/path/to/folder_a
LOCAL_ROOT_FOLDER=C:\path\to\folder_b

# ---- report labels ----
LABEL_A=Folder A
LABEL_B=Folder B
EXCEL_REPORT_PATH=folder_sync_report.xlsx

# ---- comparison behavior ----
TIMESTAMP_TOLERANCE_SECONDS=2
CASE_INSENSITIVE_MATCH=true
INCLUDE_IDENTICAL_SHEET=false
